# Server-only secret. Never expose this in frontend code and never commit a real .env file.
OPENAI_API_KEY=

# Optional. These defaults match the documented Realtime Translation models.
OPENAI_TRANSLATION_MODEL=gpt-realtime-translate
OPENAI_INPUT_TRANSCRIPTION_MODEL=gpt-realtime-whisper

# Local server. The Vite dev server proxies /api and /ws to this process.
HOST=127.0.0.1
PORT=8787
