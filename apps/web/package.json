    "test": "vitest run"
  },
  "dependencies": {
    "@lilla/shared": "*",
    "@xstate/react": "^6.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "xstate": "^5.25.0"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^2.1.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^3.2.4"
  }
}
