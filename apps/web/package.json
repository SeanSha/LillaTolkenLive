{
  "name": "@lilla/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "dev:phone": "node ./scripts/dev-phone.mjs",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
